{
  "version": "1.0",
  "service": "checkout",
  "metadata": {
    "owner": "payments-platform",
    "sampling": {
      "traces": {
        "strategy": "parent_based",
        "minimum_rate": 0.1,
        "always_sample_errors": true
      },
      "logs": {
        "strategy": "always_on",
        "minimum_rate": 1.0
      },
      "metrics": {
        "strategy": "always_on",
        "minimum_rate": 1.0
      }
    },
    "retention": {
      "traces_days": 7,
      "metrics_days": 30,
      "logs_days": 14
    }
  },
  "correlation": {
    "keys": [
      "trace_id",
      "request_id"
    ],
    "require_on": [
      "spans",
      "logs",
      "metrics"
    ]
  },
  "spans": [
    {
      "name": "checkout.request",
      "required": true,
      "fields": {
        "tenant_id": {
          "$ref": "#/field_definitions/tenant_id"
        },
        "cart_id": {
          "$ref": "#/field_definitions/cart_id"
        },
        "result": {
          "$ref": "#/field_definitions/result"
        },
        "duration_ms": {
          "type": "number",
          "required": true,
          "min": 0,
          "max": 30000,
          "unit": "ms"
        }
      }
    },
    {
      "name": "payment.authorize",
      "required": true,
      "fields": {
        "tenant_id": {
          "$ref": "#/field_definitions/tenant_id"
        },
        "payment_provider": {
          "$ref": "#/field_definitions/payment_provider"
        },
        "retry_count": {
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 3,
          "unit": "count"
        },
        "error_code": {
          "$ref": "#/field_definitions/error_code",
          "required": false
        },
        "remediation_hint": {
          "type": "string",
          "required": false
        },
        "retryable": {
          "type": "boolean",
          "required": false
        }
      },
      "conditional_requirements": [
        {
          "if": {
            "field": "error_code",
            "present": true
          },
          "then": {
            "fields": [
              "remediation_hint",
              "retryable"
            ]
          }
        }
      ]
    }
  ],
  "metrics": [
    {
      "name": "checkout.requests.total",
      "required": true,
      "value": {
        "type": "number",
        "min": 0,
        "unit": "count"
      },
      "tags": {
        "tenant_id": {
          "$ref": "#/field_definitions/tenant_id"
        },
        "result": {
          "$ref": "#/field_definitions/result"
        }
      }
    },
    {
      "name": "payment.authorization.latency_ms",
      "required": true,
      "value": {
        "type": "number",
        "min": 0,
        "max": 30000,
        "unit": "ms"
      },
      "tags": {
        "payment_provider": {
          "$ref": "#/field_definitions/payment_provider"
        }
      }
    }
  ],
  "logs": [
    {
      "name": "checkout.payment_failed",
      "required": true,
      "severity": "ERROR",
      "severity_policy": {
        "min": "ERROR"
      },
      "message_pattern": "payment authorization failed",
      "fields": {
        "tenant_id": {
          "$ref": "#/field_definitions/tenant_id"
        },
        "cart_id": {
          "$ref": "#/field_definitions/cart_id"
        },
        "error_code": {
          "$ref": "#/field_definitions/error_code"
        }
      }
    }
  ],
  "static_expectations": {
    "spans": [
      "checkout.request",
      "payment.authorize"
    ],
    "metrics": [
      "checkout.requests.total",
      "payment.authorization.latency_ms"
    ],
    "logs": [
      "checkout.payment_failed"
    ]
  },
  "scenarios": [
    {
      "id": "payment-timeout",
      "question": "Can an on-call engineer diagnose which tenant, cart, provider, and retry count were involved when payment authorization times out?",
      "requires": [
        {
          "signal": "span",
          "name": "payment.authorize",
          "fields": [
            "tenant_id",
            "payment_provider",
            "retry_count",
            "error_code"
          ]
        },
        {
          "signal": "log",
          "name": "checkout.payment_failed",
          "fields": [
            "tenant_id",
            "cart_id",
            "error_code"
          ]
        },
        {
          "signal": "metric",
          "name": "payment.authorization.latency_ms",
          "fields": [
            "payment_provider"
          ]
        }
      ]
    }
  ],
  "field_definitions": {
    "tenant_id": {
      "type": "string",
      "required": true,
      "pattern": "tenant-[a-z0-9-]+",
      "cardinality": {
        "max": 1000
      }
    },
    "cart_id": {
      "type": "string",
      "required": true,
      "pattern": "cart-[0-9]+",
      "cardinality": {
        "max": 100000
      }
    },
    "result": {
      "type": "string",
      "required": true,
      "allowed_values": [
        "ok",
        "failed"
      ]
    },
    "payment_provider": {
      "type": "string",
      "required": true,
      "allowed_values": [
        "stripe",
        "adyen",
        "test"
      ]
    },
    "error_code": {
      "type": "string",
      "required": true,
      "pattern": "[A-Z_]+"
    }
  },
  "temporal_sequences": [
    {
      "id": "checkout-payment-failure-flow",
      "group_by": [
        "trace_id"
      ],
      "window_ms": 5000,
      "steps": [
        {
          "kind": "span",
          "name": "checkout.request"
        },
        {
          "kind": "span",
          "name": "payment.authorize"
        },
        {
          "kind": "metric",
          "name": "checkout.requests.total"
        },
        {
          "kind": "log",
          "name": "checkout.payment_failed"
        }
      ]
    }
  ],
  "privacy_classifications": {
    "token": {
      "description": "Credentials or bearer tokens must not appear raw in telemetry.",
      "allowed_transformations": [
        "redacted",
        "hashed",
        "tokenized",
        "omitted"
      ]
    },
    "identifier": {
      "description": "Stable user or tenant identifiers may be raw only when explicitly approved.",
      "allowed_transformations": [
        "raw",
        "hashed",
        "tokenized"
      ]
    }
  }
}
