  "schema": "telemetry-contracts/corpus@1",
  "selection_protocol": {
    "description": "A frozen, pinned-commit corpus of public repositories that ship parseable telemetry/log data and were authored without this tool in mind. Tier 1 is a tiny multi-host fast subset; tier 2 is a larger set curated from live code search, each subject cloned and verified to ship telemetry and pinned to an exact HEAD commit SHA. Each subject is replayable byte-for-byte.",
    "criteria": [
      "public repository reachable without authentication",
      "ships at least one parseable telemetry/log file in a recognised format",
      "authored independently of this project (no contract or convention adoption)"
    ],
    "exclusions": [
      "forks",
      "archived repositories",
      "auth-required repositories"
    ],
    "notes": "Single source of truth for the corpus study. Filter with --tier N to run a fast subset (tier 1 spans github/gitlab/bitbucket)."
  },
