{
  "name": "built-in telemetry contracts benchmark",
  "cases": [
    {
      "id": "checkout-payment-timeout-pass",
      "description": "Existing checkout fixture with complete telemetry for the payment-timeout scenario.",
      "contract": "../examples/contracts/checkout.contract.json",
      "events": "../examples/telemetry/passing.jsonl",
      "scenarios": [
        "payment-timeout"
      ]
    },
    {
      "id": "gitlab-2017-database-outage-reconstructed",
      "description": "Reconstructed public historical case study based on GitLab.com's January 31, 2017 database outage postmortem.",
      "metadata": "../case_studies/gitlab_2017_database_outage/metadata.json",
      "contract": "../case_studies/gitlab_2017_database_outage/contract.json",
      "events": "../case_studies/gitlab_2017_database_outage/reconstructed_events.jsonl",
      "scenarios": [
        "restore-readiness"
      ]
    },
    {
      "id": "owasp-securetea-signin-current-static-and-hyperproperty",
      "description": "Defensive static and finite-trace hyperproperty privacy/security analysis of a public OWASP SecureTea React sign-in source file and a bounded reconstructed console-log fixture.",
      "metadata": "../case_studies/current/owasp_securetea_signin/metadata.json",
      "contract": "../case_studies/current/owasp_securetea_signin/contract.json",
      "sources": [
        "../case_studies/current/owasp_securetea_signin/Signin.js"
      ],
      "events": "../case_studies/current/owasp_securetea_signin/reconstructed_console_events.jsonl"
    },
    {
      "id": "otlp-collector-mixed-signals-pass",
      "description": "OpenTelemetry collector JSON export converted to telemetry-contracts JSONL with span, metric exemplar, and log correlation preserved.",
      "contract": "../examples/otlp/collector_mixed_signals.contract.json",
      "events": "../examples/otlp/collector_mixed_signals.events.jsonl"
    },
    {
      "id": "otlp-collector-coverage-analysis",
      "description": "Collector export coverage fixture with spans, logs, sums, gauges, histograms, exponential histograms, summaries, exemplars, links, span events, resource/scope metadata, temporality, drops, unsupported features, and PII/cardinality analysis inputs.",
      "import_diagnostics": "../examples/otlp/collector_coverage_all_signals.diagnostics.json",
      "tags": [
        "otlp",
        "collector",
        "diagnostics"
      ],
      "check_types": [
        "import_diagnostics"
      ],
      "dataset": "collector-export-semantics-fixtures",
      "expected_failure_modes": [
        "collector_dropped_evidence",
        "unsupported_otlp_feature"
      ],
      "semantics_features": [
        "collector export analysis",
        "otlp signal coverage"
      ],
      "service_owner": "collector-platform",
      "disclosure_status": "public-fixture",
      "expected_findings": [
        {
          "code": "otlp.dropped_evidence",
          "severity": "warning",
          "path": "$.resourceSpans[0].scopeSpans[0].spans[0].droppedLinksCount"
        },
        {
          "code": "otlp.unsupported_metric",
          "severity": "warning",
          "path": "$.resourceMetrics[0].scopeMetrics[0].metrics[5]"
        },
        {
          "code": "otlp.dropped_evidence",
          "severity": "warning",
          "path": "$.resourceLogs[0].scopeLogs[0].logRecords[0].droppedAttributesCount"
        },
        {
          "code": "otlp.unsupported_top_level",
          "severity": "info",
          "path": "$.partialSuccess"
        }
      ]
    },
    {
      "id": "temporal-logic-properties-fail",
      "description": "Bounded temporal-logic fixture covering safety, bounded response, absence, ordering, and deadline violations.",
      "contract": "../examples/temporal_logic/contract.json",
      "events": "../examples/temporal_logic/failing.jsonl",
      "expected_findings": [
        {
          "code": "telemetry.temporal_safety",
          "severity": "error",
          "event_index": 1
        },
        {
          "code": "telemetry.temporal_response",
          "severity": "error",
          "event_index": 2
        },
        {
          "code": "telemetry.temporal_absence",
          "severity": "error",
          "event_index": 4
        },
        {
          "code": "telemetry.temporal_order",
          "severity": "error",
          "event_index": 5
        },
        {
          "code": "telemetry.temporal_deadline",
          "severity": "error",
          "event_index": 8
        }
      ]
    },
    {
      "id": "benchmark-missing-correlation",
      "description": "Minimal public fixture that preserves span/metric data but drops log correlation keys so incident evidence cannot be joined.",
      "metadata": "../examples/benchmarks/metadata_public_semantics.json",
      "contract": "../examples/benchmarks/missing_correlation.contract.json",
      "events": "../examples/benchmarks/missing_correlation.events.jsonl",
      "tags": [
        "correlation",
        "diagnosability",
        "runtime"
      ],
      "check_types": [
        "runtime"
      ],
      "dataset": "public-benchmark-semantics-fixtures",
      "expected_failure_modes": [
        "missing_correlation"
      ],
      "semantics_features": [
        "cross-signal correlation",
        "incident diagnosability"
      ],
      "service_owner": "benchmark-platform",
      "disclosure_status": "public-fixture",
      "expected_findings": [
        {
          "code": "telemetry.correlation_missing",
          "severity": "error",
          "event_index": 2
        },
        {
          "code": "telemetry.correlation_missing",
          "severity": "error",
          "path": "events[log]"
        }
      ]
    },
    {
      "id": "benchmark-cardinality-budget",
      "description": "Minimal metric fixture whose tenant_id tag exceeds a declared bounded-cardinality budget.",
      "metadata": "../examples/benchmarks/metadata_public_semantics.json",
      "contract": "../examples/benchmarks/cardinality.contract.json",
      "events": "../examples/benchmarks/cardinality.events.jsonl",
      "tags": [
        "cardinality",
        "operability",
        "runtime"
      ],
      "check_types": [
        "runtime"
      ],
      "dataset": "public-benchmark-semantics-fixtures",
      "expected_failure_modes": [
        "high_cardinality"
      ],
      "semantics_features": [
        "cardinality budgets",
        "operability policy"
      ],
      "service_owner": "benchmark-platform",
      "disclosure_status": "public-fixture",
      "expected_findings": [
        {
          "code": "telemetry.cardinality",
          "severity": "warning",
          "path": "events[metric=checkout.requests].tenant_id"
        }
      ]
    },
    {
      "id": "benchmark-privacy-static-source",
      "description": "Public-code-style auth fixture combining raw sensitive telemetry, static secret logging, unbounded label, and missing correlation checks.",
      "metadata": "../examples/benchmarks/metadata_public_semantics.json",
      "contract": "../examples/benchmarks/privacy_static.contract.json",
      "events": "../examples/benchmarks/privacy_static.events.jsonl",
      "sources": [
        "../examples/benchmarks/privacy_static_source.py"
      ],
      "tags": [
        "privacy",
        "security",
        "static",
        "runtime"
      ],
      "check_types": [
        "runtime",
        "static"
      ],
      "dataset": "public-benchmark-semantics-fixtures",
      "expected_failure_modes": [
        "pii_exposure",
        "secret_logging",
        "unbounded_source_label",
        "missing_static_correlation"
      ],
      "semantics_features": [
        "pii non-disclosure",
        "static source checks",
        "correlation-at-source"
      ],
      "service_owner": "benchmark-auth",
      "disclosure_status": "public-fixture",
      "expected_findings": [
        {
          "code": "telemetry.sensitive_value",
          "severity": "error",
          "event_index": 1
        },
        {
          "code": "telemetry.hyper_pii_disclosure",
          "severity": "error",
          "event_index": 1
        },
        {
          "code": "static.secret_logging",
          "severity": "error",
          "path_suffix": "privacy_static_source.py:2:5-2:91"
        },
        {
          "code": "static.missing_correlation",
          "severity": "warning",
          "path_suffix": "privacy_static_source.py:2:5-2:91"
        },
        {
          "code": "static.unbounded_label",
          "severity": "warning",
          "path_suffix": "privacy_static_source.py:3:5-3:91"
        }
      ]
    },
    {
      "id": "benchmark-partial-otlp-diagnostics",
      "description": "Partial OTLP-import diagnostics fixture where a malformed public JSONL record is skipped and invalidates complete-import claims.",
      "metadata": "../examples/benchmarks/metadata_public_semantics.json",
      "import_diagnostics": "../examples/benchmarks/partial_otlp.diagnostics.json",
      "tags": [
        "otlp",
        "import",
        "diagnostics"
      ],
      "check_types": [
        "import_diagnostics"
      ],
      "dataset": "public-benchmark-semantics-fixtures",
      "expected_failure_modes": [
        "partial_otlp_import",
        "malformed_record"
      ],
      "semantics_features": [
        "import loss accounting",
        "diagnostic claim validity"
      ],
      "service_owner": "collector-platform",
      "disclosure_status": "public-fixture",
      "expected_findings": [
        {
          "code": "otlp.malformed_record",
          "severity": "warning",
          "path": "records[1]"
        }
      ]
    }
  ]
}
