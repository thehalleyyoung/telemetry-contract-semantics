              "help": {
                "text": "Redact, hash, or omit values matching forbidden sensitive patterns."
              },
              "id": "telemetry.forbidden_pattern",
              "name": "telemetry.forbidden_pattern",
              "properties": {
                "category": "privacy-security",
                "precision": "high",
                "security-severity": "7.0"
              },
              "shortDescription": {
                "text": "telemetry.forbidden_pattern"
              }
            },
            {
              "fullDescription": {
                "text": "HYP.pii-non-disclosure"
              },
              "help": {
                "text": "Redact, hash, tokenize, bucket, or omit sensitive values before they reach public telemetry sinks."
              },
              "id": "telemetry.hyper_pii_disclosure",
              "name": "telemetry.hyper_pii_disclosure",
              "properties": {
                "category": "privacy-security",
                "precision": "high",
                "security-severity": "7.0"
              },
              "shortDescription": {
                "text": "telemetry.hyper_pii_disclosure"
              }
            },
            {
              "fullDescription": {
                "text": "SAT.required-field"
              },
              "help": {
                "text": "Attach the required attribute/tag/field to the signal."
