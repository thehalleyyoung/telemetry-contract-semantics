      "tool": {
        "driver": {
          "informationUri": "https://github.com/thehalleyyoung/telemetry-contract-semantics",
          "name": "telemetry-contracts",
          "rules": [
            {
              "fullDescription": {
                "text": "OTLP.dropped-evidence"
              },
              "help": {
                "text": "Inspect collector/exporter dropped-count fields before relying on complete contract evidence."
              },
              "id": "otlp.dropped_evidence",
              "name": "otlp.dropped_evidence",
              "properties": {
                "category": "input",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "otlp.dropped_evidence"
              }
            },
            {
              "fullDescription": {
                "text": "OTLP.malformed-record"
              },
              "help": {
                "text": "Fix or exclude malformed OTLP JSONL records before asserting full export coverage."
              },
              "id": "otlp.malformed_record",
              "name": "otlp.malformed_record",
              "properties": {
                "category": "input",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "otlp.malformed_record"
              }
            },
            {
              "fullDescription": {
                "text": "OTLP.unsupported-metric"
              },
              "help": {
                "text": "Add importer support or avoid the unsupported metric encoding before making metric-contract claims."
              },
              "id": "otlp.unsupported_metric",
              "name": "otlp.unsupported_metric",
              "properties": {
                "category": "input",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "otlp.unsupported_metric"
              }
            },
            {
              "fullDescription": {
                "text": "OTLP.unsupported-top-level"
              },
              "help": {
                "text": "Document unsupported top-level OTLP fields as validity threats or add bounded importer support."
              },
              "id": "otlp.unsupported_top_level",
              "name": "otlp.unsupported_top_level",
              "properties": {
                "category": "input",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "otlp.unsupported_top_level"
              }
            },
            {
              "fullDescription": {
                "text": "ADEQ.required-field"
              },
              "help": {
                "text": "Emit the field needed to answer the scenario question."
              },
              "id": "scenario.missing_field",
              "name": "scenario.missing_field",
              "properties": {
                "category": "diagnosability",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "scenario.missing_field"
              }
            },
            {
              "fullDescription": {
                "text": "STATIC.correlation-evidence"
              },
              "help": {
                "text": "Include a trace_id, request_id, or configured correlation field in error logs."
              },
              "id": "static.missing_correlation",
              "name": "static.missing_correlation",
              "properties": {
                "category": "diagnosability",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "static.missing_correlation"
              }
            },
            {
              "fullDescription": {
                "text": "STATIC.error-status"
              },
              "help": {
                "text": "Set the OpenTelemetry span status to ERROR on error paths."
              },
              "id": "static.missing_error_status",
              "name": "static.missing_error_status",
              "properties": {
                "category": "diagnosability",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "static.missing_error_status"
              }
            },
            {
              "fullDescription": {
                "text": "STATIC.exception-recording"
              },
              "help": {
                "text": "Record caught exceptions on error spans so incident responders can inspect failure type and stack context."
              },
              "id": "static.missing_exception_recording",
              "name": "static.missing_exception_recording",
              "properties": {
                "category": "diagnosability",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "static.missing_exception_recording"
              }
            },
            {
              "fullDescription": {
                "text": "STATIC.remediation-evidence"
              },
              "help": {
                "text": "Attach a bounded remediation hint on error spans or logs when the contract requires operator guidance."
              },
              "id": "static.missing_remediation_field",
              "name": "static.missing_remediation_field",
              "properties": {
                "category": "diagnosability",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "static.missing_remediation_field"
              }
            },
            {
              "fullDescription": {
                "text": "STATIC.pii-sensitive-log"
              },
              "help": {
                "text": "Remove PII or tenant/customer identifiers from logs, or emit redacted/hash/bucketed surrogates."
              },
              "id": "static.pii_logging",
              "name": "static.pii_logging",
              "properties": {
                "category": "privacy-security",
                "precision": "high",
                "security-severity": "7.0"
              },
              "shortDescription": {
                "text": "static.pii_logging"
              }
            },
            {
              "fullDescription": {
                "text": "STATIC.raw-sensitive-log"
              },
              "help": {
                "text": "Remove the sensitive value from logs or log only a redacted/hash surrogate."
              },
              "id": "static.secret_logging",
              "name": "static.secret_logging",
              "properties": {
                "category": "privacy-security",
                "precision": "high",
                "security-severity": "7.0"
              },
              "shortDescription": {
                "text": "static.secret_logging"
              }
            },
            {
              "fullDescription": {
                "text": "STATIC.cardinality-risk"
              },
              "help": {
                "text": "Avoid user-controlled/high-cardinality metric labels or add bucketing."
              },
              "id": "static.unbounded_label",
              "name": "static.unbounded_label",
              "properties": {
                "category": "operability",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "static.unbounded_label"
              }
            },
            {
              "fullDescription": {
                "text": "STATIC.payload-preview"
              },
              "help": {
                "text": "Replace raw payload/body previews with allowlisted sanitized previews or omit them."
              },
              "id": "static.unsafe_payload_preview",
              "name": "static.unsafe_payload_preview",
              "properties": {
                "category": "privacy-security",
                "precision": "high",
                "security-severity": "7.0"
              },
              "shortDescription": {
                "text": "static.unsafe_payload_preview"
              }
            },
            {
              "fullDescription": {
                "text": "SAT.allowed-values"
