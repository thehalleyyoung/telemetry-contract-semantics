              "properties": {
                "category": "operability",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
                "text": "telemetry.cardinality"
              }
            },
            {
              "fullDescription": {
                "text": "SAT.correlation-presence"
              },
              "help": {
                "text": "Emit a trace_id, span_id, request_id, or configured correlation key on correlated signals."
              },
              "id": "telemetry.correlation_missing",
              "name": "telemetry.correlation_missing",
              "properties": {
                "category": "diagnosability",
                "precision": "high",
                "security-severity": "4.0"
              },
              "shortDescription": {
