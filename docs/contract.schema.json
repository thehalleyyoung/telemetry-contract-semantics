{
  "$defs": {
    "alternativeObligation": {
      "properties": {
        "any_of": {
          "items": {
            "$ref": "#/$defs/alternativeOption"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "any_of"
      ],
      "type": "object"
    },
    "alternativeOption": {
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "span",
            "log",
            "metric",
            "spans",
            "logs",
            "metrics"
          ]
        },
        "name": {
          "type": "string"
        },
        "signal": {
          "enum": [
            "span",
            "log",
            "metric",
            "spans",
            "logs",
            "metrics"
          ]
        }
      },
      "required": [
        "signal",
        "name"
      ],
      "type": "object"
    },
    "baseSignal": {
      "properties": {
        "attributes": {
          "$ref": "#/$defs/fieldMap"
        },
        "conditional_requirements": {
          "items": {
            "$ref": "#/$defs/conditionalRequirement"
          },
          "type": "array"
        },
        "fields": {
          "$ref": "#/$defs/fieldMap"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "tags": {
          "$ref": "#/$defs/fieldMap"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "cardinality": {
      "properties": {
        "max": {
          "type": "integer"
        },
        "policy": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "conditionalRequirement": {
      "properties": {
        "if": {
          "$ref": "#/$defs/fieldCondition"
        },
        "then": {
          "$ref": "#/$defs/conditionalThen"
        }
      },
      "required": [
        "if",
        "then"
      ],
      "type": "object"
    },
    "conditionalThen": {
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "correlationPolicy": {
      "properties": {
        "keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "require_on": {
          "items": {
            "enum": [
              "spans",
              "logs",
              "metrics",
              "span",
              "log",
              "metric"
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "keys"
      ],
      "type": "object"
    },
    "fieldCondition": {
      "properties": {
        "allowed_values": {
          "type": "array"
        },
        "equals": {},
        "field": {
          "type": "string"
        },
        "present": {
          "type": "boolean"
        }
      },
      "required": [
        "field"
      ],
      "type": "object"
    },
    "fieldMap": {
      "additionalProperties": {
        "$ref": "#/$defs/fieldSpec"
      },
      "type": "object"
    },
    "fieldSpec": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "properties": {
            "$ref": {
              "type": "string"
            },
            "allow_raw_sensitive": {
              "type": "boolean"
            },
            "allowed_values": {
              "type": "array"
            },
            "cardinality": {
              "$ref": "#/$defs/cardinality"
            },
            "classification": {
              "type": "string"
            },
            "forbidden_patterns": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/forbiddenPattern"
                },
                {
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/forbiddenPattern"
                      }
                    ]
                  },
                  "type": "array"
                }
              ]
            },
            "max": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "pattern": {
              "type": "string"
            },
            "pii": {
              "type": "boolean"
            },
            "privacy_classification": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "regex": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "sensitivity": {
              "type": "string"
            },
            "transformation": {
              "enum": [
                "raw",
                "redacted",
                "hashed",
                "tokenized",
                "bucketed",
                "omitted"
              ]
            },
            "type": {
              "$ref": "#/$defs/primitive"
            },
            "unit": {
              "type": "string"
            }
          },
          "type": "object"
        }
      ]
    },
    "forbiddenPattern": {
      "properties": {
        "name": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "logSignal": {
      "allOf": [
        {
          "$ref": "#/$defs/baseSignal"
        },
        {
          "properties": {
            "message_pattern": {
              "type": "string"
            },
            "severity": {
              "type": "string"
            },
            "severity_policy": {
              "$ref": "#/$defs/severityPolicy"
            }
          },
          "type": "object"
        }
      ]
    },
    "metadata": {
      "properties": {
        "owner": {
          "type": "string"
        },
        "retention": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "sampling": {
          "additionalProperties": {
            "$ref": "#/$defs/samplingPolicy"
          },
          "type": "object"
        },
        "transformation_preservation": {
          "properties": {
            "approved_transformations": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "claim": {
              "type": "string"
            },
            "preserve_scenarios": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "metricSignal": {
      "allOf": [
        {
          "$ref": "#/$defs/baseSignal"
        },
        {
          "properties": {
            "value": {
              "$ref": "#/$defs/fieldSpec"
            }
          },
          "type": "object"
        }
      ]
    },
    "primitive": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "object",
        "array",
        "null",
        "str",
        "int",
        "float",
        "bool",
        "dict",
        "list"
      ]
    },
    "privacyClassification": {
      "properties": {
        "allowed_transformations": {
          "items": {
            "enum": [
              "raw",
              "redacted",
              "hashed",
              "tokenized",
              "bucketed",
              "omitted"
            ]
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "allowed_transformations"
      ],
      "type": "object"
    },
    "samplingPolicy": {
      "properties": {
        "always_keep_errors": {
          "type": "boolean"
        },
        "always_sample_errors": {
          "type": "boolean"
        },
        "minimum_rate": {
          "type": "number"
        },
        "rate": {
          "type": "number"
        },
        "strategy": {
          "enum": [
            "always_on",
            "always_off",
            "parent_based",
            "probabilistic",
            "tail_based",
            "rate_limited"
          ]
        }
      },
      "type": "object"
    },
    "scenario": {
      "anyOf": [
        {
          "required": [
            "requires"
          ]
        },
        {
          "required": [
            "minimum_observations"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "minimum_observations": {
          "items": {
            "$ref": "#/$defs/scenarioRequirement"
          },
          "type": "array"
        },
        "question": {
          "type": "string"
        },
        "requires": {
          "items": {
            "$ref": "#/$defs/scenarioRequirement"
          },
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "scenarioRequirement": {
      "anyOf": [
        {
          "required": [
            "signal",
            "name"
          ]
        },
        {
          "required": [
            "any_of"
          ]
        }
      ],
      "properties": {
        "any_of": {
          "items": {
            "$ref": "#/$defs/alternativeOption"
          },
          "type": "array"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "signal": {
          "enum": [
            "span",
            "log",
            "metric"
          ]
        }
      },
      "type": "object"
    },
    "severityPolicy": {
      "properties": {
        "min": {
          "type": "string"
        },
        "minimum": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "spanSignal": {
      "allOf": [
        {
          "$ref": "#/$defs/baseSignal"
        }
      ]
    },
    "staticExpectations": {
      "properties": {
        "logs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "spans": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "temporalSequence": {
      "properties": {
        "group_by": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/temporalStep"
          },
          "type": "array"
        },
        "window_ms": {
          "type": "number"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    },
    "temporalStep": {
      "properties": {
        "kind": {
          "enum": [
            "span",
            "log",
            "metric",
            "spans",
            "logs",
            "metrics"
          ]
        },
        "name": {
          "type": "string"
        },
        "signal": {
          "enum": [
            "span",
            "log",
            "metric",
            "spans",
            "logs",
            "metrics"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "$id": "https://example.org/telemetry-contracts/contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "alternative_obligations": {
      "items": {
        "$ref": "#/$defs/alternativeObligation"
      },
      "type": "array"
    },
    "correlation": {
      "$ref": "#/$defs/correlationPolicy"
    },
    "field_definitions": {
      "additionalProperties": {
        "$ref": "#/$defs/fieldSpec"
      },
      "type": "object"
    },
    "logs": {
      "items": {
        "$ref": "#/$defs/logSignal"
      },
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/metricSignal"
      },
      "type": "array"
    },
    "privacy_classifications": {
      "additionalProperties": {
        "$ref": "#/$defs/privacyClassification"
      },
      "type": "object"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "type": "array"
    },
    "service": {
      "type": "string"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/spanSignal"
      },
      "type": "array"
    },
    "static_expectations": {
      "$ref": "#/$defs/staticExpectations"
    },
    "static_rules": {
      "type": "object"
    },
    "temporal_sequences": {
      "items": {
        "$ref": "#/$defs/temporalSequence"
      },
      "type": "array"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    }
  },
  "required": [
    "version",
    "service"
  ],
  "title": "Telemetry Contracts contract",
  "type": "object"
}
